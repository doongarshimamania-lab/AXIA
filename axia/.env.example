# ═══════════════════════════════════════════════════════════
# AXIA — Environment Variables Template
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════

# ── Convex Backend ──
VITE_CONVEX_URL=https://your-project.convex.cloud
# Required for Better Auth (HTTP routes). Same as VITE_CONVEX_URL but ends in .site
VITE_CONVEX_SITE_URL=https://your-project.convex.site
# Your local dev URL (used by Better Auth for trustedOrigins)
VITE_SITE_URL=http://localhost:3000

# ───────────────────────────────────────────────────────────
# Better Auth (server-side, set on Convex via `npx convex env set`)
# ───────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Same as VITE_SITE_URL — your app's public URL
SITE_URL=http://localhost:3000
# Same as VITE_CONVEX_SITE_URL — auto-set by Convex
CONVEX_SITE_URL=https://your-project.convex.site

# ───────────────────────────────────────────────────────────
# OAuth providers (server-side, set on Convex via `npx convex env set`)
# ───────────────────────────────────────────────────────────
# Create at https://console.cloud.google.com/apis/credentials
# Redirect URI: https://<your-convex-site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Create at https://portal.azure.com → Microsoft Entra ID → App registrations
# Redirect URI: https://<your-convex-site>/api/auth/callback/microsoft
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# ───────────────────────────────────────────────────────────
# Resend (email — server-side, set on Convex via `npx convex env set`)
# ───────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
# Without a verified domain, set EMAIL_FROM to "Your Name <onboarding@resend.dev>"
# For production: verify your domain (axia.com) in Resend dashboard, then set
# EMAIL_FROM to "Axia <noreply@axia.com>"
RESEND_API_KEY=
EMAIL_FROM=Axia <noreply@axia.com>

# ── Sentry Error Tracking ──
# Client-side (VITE_ prefix — exposed to browser)
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=axia
VITE_SENTRY_PROJECT=axia

# ── PostHog Product Analytics ──
# Client-side (VITE_ prefix — exposed to browser)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Release Tracking ──
VITE_GIT_SHA=dev

# ═══════════════════════════════════════════════════════════
# OWNER DASHBOARD — Server-side API keys (set on Convex via `npx convex env set`)
# These are NEVER exposed to the browser. All calls go through Convex actions.
# ═══════════════════════════════════════════════════════════

# ── Sentry REST API (for owner dashboard Errors tab) ──
# Generate at: sentry.io → Settings → API Keys → Auth Tokens
# Scopes needed: org:read, project:read, event:read
SENTRY_AUTH_TOKEN=
SENTRY_ORG_SLUG=axia

# ── PostHog API (for owner dashboard Product tab) ──
# Generate at: app.posthog.com → Me → Settings → Personal API Keys
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=

# ── Vercel API (for owner dashboard Infrastructure tab) ──
# Generate at: vercel.com → Settings → Tokens
VERCEL_ACCESS_TOKEN=
VERCEL_PROJECT_ID=

# ── Paddle (AXIA's own SaaS billing — NOT agency invoice collection) ──
# Generate at: vendors.paddle.com → Developer Tools → Authentication
# Environment: "sandbox" or "production"
PADDLE_API_KEY=
PADDLE_ENVIRONMENT=sandbox
PADDLE_WEBHOOK_SECRET=
# Client-side Paddle.js key (for checkout overlay)
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_ENVIRONMENT=sandbox
