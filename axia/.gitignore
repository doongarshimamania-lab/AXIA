# ─────────────────────────────────────────────────────────────
# AXIA production code .gitignore
# All non-production content lives in /resources/ (top-level)
# ─────────────────────────────────────────────────────────────

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
.next/
*.tsbuildinfo

# Vite build artifacts (regenerated by `vite build`)
public/assets/
public/timelock/

# Environment secrets
.env
.env.local
.env.*.local
# .env.example IS tracked (template, no secrets)

# Convex local backend (regenerated by `npx convex dev`)
.convex/
convex_local_backend.sqlite3
*.db
*.sqlite3

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Test coverage
coverage/
.nyc_output/

# Temp / cache
.cache/
*.tmp
