# ponytail: Vercel ignore list — prevents accidental inclusion of non-app files
# This file lives in axia/ (the Vercel root directory), so paths are relative to axia/.
#
# CRITICAL: all directory patterns are anchored with a leading "/" so they only
# match at the axia/ root, NOT at any nested level. Without the leading slash,
# gitignore semantics would match the pattern at any depth — e.g. `convex/`
# would also exclude `src/convex/` (which contains the _generated/api.js that
# Vite must bundle for the build to succeed).

# Build artifacts (regenerated by Vercel during build)
/dist/
/build/
/.next/

# Local Convex backend cache (dev-only, not needed at build/runtime)
/.convex/

# Local dev databases (top-level only)
/db/

# Logs
*.log
/logs/

# Editor / OS files
.DS_Store
/.vscode/
/.idea/
Thumbs.db

# Environment files (Vercel uses dashboard env vars, not .env files)
.env
.env.local
.env.*.local

# Test / coverage
/coverage/

# NOTE: src/convex/ is NOT ignored. It contains:
#   - src/convex/_generated/api.js    ← imported by Vite during build
#   - src/convex/_generated/server.js ← imported by Vite during build
#   - schema.ts, *.ts mutation/query files referenced by api.d.ts
# The Convex backend itself deploys separately to Convex Cloud via
# `npx convex deploy`, not via Vercel.
