# ponytail: Vercel ignore list — prevents accidental inclusion of non-app files
# This file lives in axia/ (the Vercel root directory), so paths are relative to axia/.

# Convex backend (deployed separately to Convex Cloud, not to Vercel)
convex/

# Local dev databases
db/
*.sqlite3
*.db

# Build artifacts (will be regenerated by Vercel)
dist/
build/
.next/

# Logs
*.log
logs/

# Editor / OS files
.DS_Store
.vscode/
.idea/
Thumbs.db

# Environment files (Vercel uses dashboard env vars, not .env files)
.env
.env.local
.env.*.local

# Documentation (not needed for runtime)
*.md
!README.md

# Test / coverage
coverage/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx

# Scripts directory (not part of runtime)
scripts/
