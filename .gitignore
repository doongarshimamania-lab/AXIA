# ─────────────────────────────────────────────────────────────
# AXIA — Top-level .gitignore
# Repo is organized into two top-level folders:
#   axia/        → production-ready code (has its own .gitignore too)
#   resources/   → everything else (backups, snapshots, research,
#                  screenshots, scripts, docs) — tracked
# ─────────────────────────────────────────────────────────────

# Dependencies (anywhere in the repo)
node_modules/

# Build output (anywhere in the repo)
dist/
dist-ssr/
.next/
*.tsbuildinfo

# Environment secrets (anywhere — never tracked)
.env
.env.local
.env.*.local
# NOTE: .env.example IS tracked (it's a template, no secrets)

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Convex local backend
convex_local_backend.sqlite3
*.db
*.sqlite3

# ─── Workspace orchestration scripts (not app source) ───
/.zscripts/

# ─── System mounts — cannot be moved, must be gitignored ───
# IM gateway upload mount (runtime, not source)
/upload/
# Z.ai skills library (1023 files — not AXIA source)
/skills/
# Final user-facing deliverables (PDFs, screenshots, audit reports,
# backup zips). These are produced by audits/scripts and stored for
# download — never tracked.
/download/

# ─── Transient agent scratch (not source) ───
/resources/tool-results/
/tool-results/

# ─── Large binaries (GitHub Releases only, >100 MB) ───
*.zip
*.tar.gz
*.tar.bz2
# Allow small zips in resources/backups for archival
!resources/backups/*.zip
# ...actually no, GitHub refuses >100 MB. Exclude all zips.
resources/backups/*.zip

# ─── Runtime files ───
*.pid
*.seed

# ─── Convex auth config (auto-generated, may contain dev keys) ───
axia/.convex/
