# ─────────────────────────────────────────────────────────────
# AXIA — Top-level .gitignore
# Repo is organized into two top-level folders:
#   axia/        → production code (has its own .gitignore too)
#   resources/   → archive, backups, research, screenshots, etc.
# ─────────────────────────────────────────────────────────────

# Dependencies (anywhere in the repo)
node_modules/

# Build output (anywhere in the repo)
dist/
dist-ssr/
.next/
*.tsbuildinfo

# Environment secrets (anywhere)
.env
.env.local
.env.*.local
# NOTE: .env.example IS tracked (it's a template, no secrets)

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Convex local backend
convex_local_backend.sqlite3
*.db
*.sqlite3

# ── resources/-specific ignores ──
# IM gateway upload mount (system mount, can't be moved, gitignored)
/upload/

# Z.ai skill library (large, not app code)
/resources/skills/

# Big binary backups — store in GitHub Releases instead
/resources/backups/*.tar.gz
/resources/backups/*.zip
/resources/backups/timelock-fullcode-*

# Old src backups (archive-only, not for editing)
/resources/src_backup_*/

# Tool results (transient agent artifacts)
/resources/tool-results/

# Disk mirror of dist (build artifact)
/resources/disk/

# Uploads via IM gateway (runtime, not source)
/resources/upload/

# Large backup ZIPs — too big for git (>100MB GitHub limit).
# These live in GitHub Releases instead (per rules file backup policy).
/resources/download/AXIA-COMPLETE-BACKUP-*.zip
/resources/backups/*.zip

# Screenshots are tracked (small, useful for docs)
