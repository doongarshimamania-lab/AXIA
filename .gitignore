# ─────────────────────────────────────────────────────────────
# AXIA — Top-level .gitignore
# Repo is organized into two top-level folders:
#   axia/        → production code (has its own .gitignore too)
#   resources/   → archive, backups, research, screenshots, etc.
# ─────────────────────────────────────────────────────────────

# Dependencies (anywhere in the repo)
node_modules/

# Build output (anywhere in the repo)
dist/
dist-ssr/
.next/
*.tsbuildinfo

# Environment secrets (anywhere)
.env
.env.local
.env.*.local
# NOTE: .env.example IS tracked (it's a template, no secrets)

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Convex local backend
convex_local_backend.sqlite3
*.db
*.sqlite3

# ── resources/-specific ignores ──
# IM gateway upload mount (system mount, can't be moved, gitignored)
/upload/

# Z.ai skill library (large, not app code)
/resources/skills/

# Big binary backups — store in GitHub Releases instead
/resources/backups/*.tar.gz
/resources/backups/*.zip
/resources/backups/timelock-fullcode-*

# Old src backups (archive-only, not for editing)
/resources/src_backup_*/

# Tool results (transient agent artifacts)
/resources/tool-results/

# Disk mirror of dist (build artifact)
/resources/disk/

# Uploads via IM gateway (runtime, not source)
/resources/upload/

# Large backup ZIPs — too big for git (>100MB GitHub limit).
# These live in GitHub Releases instead (per rules file backup policy).
/resources/download/AXIA-COMPLETE-BACKUP-*.zip
/resources/backups/*.zip

# Screenshots are tracked (small, useful for docs)

# ─── v5.4.0 security-audit cleanup ──────────────────────────────────────
# The repo should be LEAN: only axia/ production code + small top-level
# metadata. Everything else is build output, deliverables, multi-agent
# scratch space, or unrelated projects. Untracked files remain on disk.

# Top-level tool-results (transient agent scratch)
/tool-results/

# Z.ai skills library (1023 files — not part of AXIA source)
/skills/

# Deliverables (PDFs, screenshots, audit reports, backup zips).
# These are produced by audits/scripts and should never be tracked.
# A 16 MB backup zip was previously tracked — removed in v5.4.0.
/download/

# Anything under resources/ is archive/backup/scratch — untrack all of it.
# (Files stay on disk; just not in git.)
/resources/

# Multi-agent workdir at root (transient)
/agent-ctx/

# Build/orchestration scripts at root (not app runtime)
/.zscripts/

# Misc standalone backups at root
/backups/
/src_backup_*/
/timelock-messy-backup/
/timelock/             # duplicate sub-project — see axia/ for production code
/disk/                 # build output (was previously tracked)
/ecc/
/examples/

# Research / planning JSON at root (input data, not source)
/research_*.json

# Binary archives anywhere
*.zip
*.tar.gz
*.tar.bz2

# Runtime files
*.pid
*.seed
