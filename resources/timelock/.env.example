# ═══════════════════════════════════════════════════════════
# AXIA — Environment Variables Template
# Copy this file to .env and fill in the values
# ═══════════════════════════════════════════════════════════

# ── Convex Backend ──
VITE_CONVEX_URL=https://your-project.convex.cloud

# ── Sentry Error Tracking ──
# Get your DSN from: https://sentry.io/settings/projects/ -> Client Keys -> DSN
# Leave empty to skip Sentry initialization (safe for local dev)
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=axia
VITE_SENTRY_PROJECT=axia
# SENTRY_AUTH_TOKEN is set in CI/CD, not here (no VITE_ prefix = not exposed to client)

# ── PostHog Product Analytics ──
# Get your key from: https://app.posthog.com/project/settings -> Project API Key
# Leave empty to skip PostHog initialization (safe for local dev)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Release Tracking ──
# Set to the git SHA for release tracking in Sentry/PostHog
VITE_GIT_SHA=dev

# ── Vly (Optional — internal tooling) ──
VITE_VLY_APP_ID=
VITE_VLY_MONITORING_URL=
